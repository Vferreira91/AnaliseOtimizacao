{
  "info": {
    "name": "AnaliseOtimizacao: demonstração",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Requisições do vídeo, na ordem de docs/roteiro-video.md. Veja os cabeçalhos X-Cache, X-SQL-Count e X-Elapsed-Ms na aba Headers da resposta, ou resumidos na aba Test Results. Antes de gravar: SPRING_PROFILES_ACTIVE=demo docker compose --profile carga up -d app e ./analise/demo.sh aquecer. Depois: ./analise/demo.sh restaurar."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "n",
      "value": "10"
    }
  ],
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Resume os cabeçalhos de instrumentação na aba Test Results.",
          "['X-Cache', 'X-SQL-Count', 'X-SQL-Ms', 'X-Elapsed-Ms'].forEach((nome) => {",
          "  const valor = pm.response.headers.get(nome);",
          "  if (valor !== undefined) pm.test(`${nome}: ${valor}`, () => {});",
          "});"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "1. API",
      "description": "",
      "item": [
        {
          "name": "Produto 42 (sem cache)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/produtos/42/sem-cache",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "produtos",
                "42",
                "sem-cache"
              ]
            },
            "description": ""
          }
        },
        {
          "name": "Pedidos do cliente 5000",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/clientes/5000/pedidos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "clientes",
                "5000",
                "pedidos"
              ]
            },
            "description": ""
          }
        }
      ]
    },
    {
      "name": "2. Cache",
      "description": "Profile demo: TTL de 20 s. O TTL aparece no terminal: docker exec ao-redis redis-cli TTL produtos::42",
      "item": [
        {
          "name": "Esvaziar o cache",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/admin/cache",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "admin",
                "cache"
              ]
            },
            "description": "Estado inicial controlado: cache vazio."
          }
        },
        {
          "name": "Produto 42 com cache (envie 2 vezes: MISS, depois HIT)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/produtos/42/com-cache",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "produtos",
                "42",
                "com-cache"
              ]
            },
            "description": ""
          }
        },
        {
          "name": "Alterar o produto 42 (invalida o cache)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/produtos/42",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "produtos",
                "42"
              ]
            },
            "description": "Grava no banco e remove a chave produtos::42 do Redis depois do commit. Confira no terminal: docker exec ao-redis redis-cli EXISTS produtos::42",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"preco\": 299.9,\n  \"estoque\": 150\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Produto 42 com cache (MISS com o preço novo)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/produtos/42/com-cache",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "produtos",
                "42",
                "com-cache"
              ]
            },
            "description": ""
          }
        },
        {
          "name": "Relatório com cache (envie 2 vezes: ~1 s, depois ~1 ms)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/relatorios/vendas-por-categoria/com-cache",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "relatorios",
                "vendas-por-categoria",
                "com-cache"
