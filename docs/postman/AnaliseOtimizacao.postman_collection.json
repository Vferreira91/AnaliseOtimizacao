            "description": ""
          }
        },
        {
          "name": "Relatório sem cache",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/relatorios/vendas-por-categoria/sem-cache",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "relatorios",
                "vendas-por-categoria",
                "sem-cache"
              ]
            },
            "description": ""
          }
        },
        {
          "name": "Devolver o produto 42 ao preço original",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/produtos/42",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "produtos",
                "42"
              ]
            },
            "description": "Restaura preço e estoque. A data de atualização original volta com ./analise/demo.sh restaurar.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"preco\": 244.88,\n  \"estoque\": 200\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },
